{
  "api": {
    "baseUrl": "https://api.example.com",
    "version": "v1",
    "timeout": 5000,
    "retryAttempts": 3
  },
  "endpoints": {
    "inventory": "/newcms/mobile/inventory",
    "scan": "/newcms/mobile/scan",
    "adjust": "/newcms/mobile/adjust",
    "restaurantOverview": "/newcms/restaurant/overview"
  },
  "authentication": {
    "type": "jwt",
    "tokenKey": "access_token",
    "refreshTokenKey": "refresh_token",
    "expiryKey": "expires_at"
  },
  "inventory": {
    "defaultPageSize": 50,
    "maxPageSize": 200,
    "cacheEnabled": true,
    "cacheDuration": 300000,
    "searchDebounce": 300
  },
  "scanner": {
    "enabled": true,
    "vibrationOnScan": true,
    "soundOnScan": true,
    "autoFocus": true,
    "scanTimeout": 30000,
    "supportedFormats": [
      "EAN13",
      "EAN8",
      "CODE128",
      "CODE39",
      "QR_CODE"
    ]
  },
  "adjustments": {
    "reasons": [
      {
        "value": "breakage",
        "label": "Casse",
        "icon": "broken-glass",
        "color": "#FF6B6B"
      },
      {
        "value": "theft",
        "label": "Vol",
        "icon": "alert-circle",
        "color": "#FF4757"
      },
      {
        "value": "error",
        "label": "Erreur inventaire",
        "icon": "edit-3",
        "color": "#FFA502"
      },
      {
        "value": "expiry",
        "label": "Péremption",
        "icon": "calendar-x",
        "color": "#95A5A6"
      },
      {
        "value": "other",
        "label": "Autre",
        "icon": "more-horizontal",
        "color": "#3742FA"
      }
    ],
    "requireNotes": false,
    "requirePhotoForBreakage": false,
    "requirePhotoForExpiry": false,
    "allowNegativeAdjustments": true,
    "allowAbsoluteMode": true,
    "confirmBeforeSubmit": true
  },
  "ui": {
    "theme": "light",
    "primaryColor": "#3742FA",
    "accentColor": "#FF6B6B",
    "showStockLevels": true,
    "showAlertThresholds": true,
    "showLastUpdate": true,
    "animationsEnabled": true
  },
  "offline": {
    "enabled": false,
    "syncInterval": 60000,
    "maxOfflineActions": 100,
    "retryFailedActions": true
  },
  "notifications": {
    "lowStockAlerts": true,
    "adjustmentConfirmations": true,
    "syncStatus": true
  },
  "security": {
    "requirePinForAdjustments": false,
    "maxAdjustmentValue": 1000,
    "logAllActions": true,
    "encryptLocalData": false
  },
  "performance": {
    "enableCaching": true,
    "prefetchInventory": true,
    "lazyLoadImages": true,
    "debounceSearch": 300,
    "maxConcurrentRequests": 5
  },
  "debug": {
    "enabled": false,
    "logLevel": "info",
    "showNetworkCalls": false,
    "showPerformanceMetrics": false
  }
}
